{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OctaPOS",
  "version": "0.1.0",
  "identifier": "com.octapos.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "OctaPOS",
        "width": 1366,
        "height": 768,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "publisher": "OctaPOS",
    "copyright": "Copyright © 2026 OctaPOS",
    "shortDescription": "Aplikasi Point of Sale offline-first",
    "longDescription": "OctaPOS adalah aplikasi kasir modern yang bekerja tanpa internet dan sinkronisasi otomatis ke cloud."
  },
  "plugins": {
    "sql": {
      "preloadConnections": [
        "sqlite:octapos.db"
      ]
    },
    "updater":{
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzOTY0QUZBNDIwMjUzRDQKUldUVVV3SkMra3FXRTEzRitEVTYvaVlWc2RzOUZ2RXdVVUNzQWZ6emJGUjNLckthUGhlSU1ZbEYK"
    }
  }
}
